# ===== 密钥与配置（永远不上传）=====
# 存数据库连接串、密码、API 密钥的本地配置文件
.env
.env.*
*.env

# 证书与密钥文件
*.pem
*.key

# ===== 依赖目录（体积大，可随时用 npm install 重新生成）=====
node_modules/

# ===== 本地数据库文件（只存在于你电脑上）=====
*.db
*.sqlite
*.sqlite3

# ===== 日志与临时文件 =====
*.log
tmp/
.temp/

# ===== AI 工作笔记（WorkBuddy 的记忆目录，不是网站代码）=====
.workbuddy/

# ===== 操作系统自动生成的文件 =====
.DS_Store
Thumbs.db
desktop.ini
